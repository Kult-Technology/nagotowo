# NA GOTOWO - ustawienia serwera (Apache / LiteSpeed)

# Brak listowania katalogów
Options -Indexes

# Pliki i katalogi zaczynające się od kropki (np. .git, .idea) nie są dostępne z przeglądarki.
# .well-known zostaje otwarte, bo korzysta z niego odnawianie certyfikatu SSL.
RedirectMatch 404 /\.(?!well-known/)

# Typy plików
AddType image/webp .webp
AddType font/woff2 .woff2

# Kompresja strony, żeby ładowała się szybciej
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Przeglądarka zapamiętuje zdjęcia i czcionki, strona główna zawsze świeża
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Zawsze https://nagotowobialystok.pl: wejścia przez http i przez www przekierowują na adres główny.
# Certyfikat SSL na hostingu OVH jest włączony dla obu adresów (z www i bez).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://nagotowobialystok.pl%{REQUEST_URI} [L,R=301]
</IfModule>
