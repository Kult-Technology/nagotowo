# NA GOTOWO - ustawienia serwera (Apache / LiteSpeed)

# Brak listowania katalogów
Options -Indexes

# Typy plików
AddType image/webp .webp
AddType font/woff2 .woff2

# Kompresja strony, żeby ładowała się szybciej
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Przeglądarka zapamiętuje zdjęcia i czcionki, strona główna zawsze świeża
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Przekierowanie na https. Odkomentuj trzy linie poniżej dopiero po włączeniu certyfikatu SSL,
# chyba że hosting ma w panelu opcję "wymuś SSL" (wtedy użyj jej i zostaw to bez zmian).
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
